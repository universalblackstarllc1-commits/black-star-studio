/** Black Star Studio. Private operations require the workspace key in a POST body. */
function props_(){return PropertiesService.getScriptProperties();}
function required_(name){const v=props_().getProperty(name);if(!v)throw Error('Missing server configuration: '+name);return v;}
function digest_(s){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(s)).map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('');}
function same_(a,b){a=digest_(a);b=digest_(b);let diff=0;for(let i=0;i<a.length;i++)diff|=a.charCodeAt(i)^b.charCodeAt(i);return diff===0;}
function locked_(fn){const l=LockService.getScriptLock();l.waitLock(20000);try{return fn();}finally{l.releaseLock();}}
/** Run once in the Apps Script editor. Inspect Script Properties for the generated key. */
function setup(){const p=props_();if(!p.getProperty('WORKSPACE_KEY'))p.setProperty('WORKSPACE_KEY',Utilities.getUuid()+Utilities.getUuid());if(!p.getProperty('SPREADSHEET_ID')){const s=SpreadsheetApp.create('Black Star Studio — Universal Black Star');p.setProperty('SPREADSHEET_ID',s.getId());}const s=SpreadsheetApp.openById(required_('SPREADSHEET_ID'));[['Posts',['id','json','revision','updatedAt','status']],['Audit',['timestamp','action','postId']]].forEach(([name,headers])=>{let sh=s.getSheetByName(name);if(!sh)sh=s.insertSheet(name);if(sh.getLastRow()===0){sh.appendRow(headers);sh.setFrozenRows(1);}});return 'Setup complete. Find SPREADSHEET_ID and WORKSPACE_KEY in Project Settings > Script Properties. Do not publish them.';}
function posts_(){return SpreadsheetApp.openById(required_('SPREADSHEET_ID')).getSheetByName('Posts');}
function all_(){const s=posts_();return s.getLastRow()<2?[]:s.getRange(2,1,s.getLastRow()-1,5).getValues().map(r=>JSON.parse(r[1]));}
function locate_(id){const s=posts_(),rows=s.getDataRange().getValues();for(let i=1;i<rows.length;i++)if(rows[i][0]===id)return {sheet:s,row:i+1,post:JSON.parse(rows[i][1])};return null;}
function audit_(action,id){SpreadsheetApp.openById(required_('SPREADSHEET_ID')).getSheetByName('Audit').appendRow([new Date().toISOString(),action,id||'']);}
function put_(p,found){p.updatedAt=new Date().toISOString();p.revision=(found?found.post.revision:0)+1;const row=[p.id,JSON.stringify(p),p.revision,p.updatedAt,p.status];if(found)found.sheet.getRange(found.row,1,1,5).setValues([row]);else posts_().appendRow(row);SpreadsheetApp.flush();return p;}
function authorized_(r){const key=required_('WORKSPACE_KEY');if(typeof r.key!=='string'||!same_(r.key,key))throw Error('Workspace authorization failed.');if(r.origin!==required_('PAGE_ORIGIN'))throw Error('Origin does not match PAGE_ORIGIN.');}
function validatePost_(p){const errors=StudioCore.issues(p);if(errors.length)throw Error(errors.join(' '));}
function version_(found,revision){if(!found)throw Error('Post not found.');if(found.post.revision!==revision)throw Error('This post changed in another tab. Reconnect to load the latest version.');}
function ready_(){const p=props_();return p.getProperty('LINKEDIN_APPROVED')==='true'&&/^\d+$/.test(p.getProperty('LINKEDIN_ORGANIZATION_ID')||'')&&/^\d{6}$/.test(p.getProperty('LINKEDIN_VERSION')||'')&&!!p.getProperty('LINKEDIN_ACCESS_TOKEN')&&Number(p.getProperty('LINKEDIN_EXPIRES_AT'))>Date.now()+60000;}
function dispatch_(r){const d=r.data||{};switch(r.action){
 case 'load':return {posts:all_(),linkedinReady:ready_()};
 case 'status':return {ready:ready_(),message:ready_()?'Server has an unexpired token and publishing configuration. LinkedIn verifies Page permissions when you publish.':'API publishing is unavailable. Check approval, organization ID, API version and token expiry. Manual publishing remains available.'};
 case 'save':return locked_(()=>{const p=StudioCore.cleanPost(d.post||{});if(!/^[A-Za-z0-9_-]{1,100}$/.test(p.id))throw Error('Invalid post ID.');if(!['draft','approved','planned'].includes(p.status))throw Error('Use the publishing action to record a publication.');const f=locate_(p.id);if(f){version_(f,p.revision);if(!['draft','approved','planned'].includes(f.post.status))throw Error('Published or uncertain posts are locked. Reconcile the publication first.');}else if(p.revision)throw Error('Post revision does not exist in the shared workspace.');if(p.status!=='draft')validatePost_(p);if(p.status==='planned'&&(!p.scheduledAt||isNaN(Date.parse(p.scheduledAt))))throw Error('Planned posts need a valid date and time.');p.publishedUrl='';const saved=put_(p,f);audit_('save',p.id);return saved;});
 case 'delete':return locked_(()=>{const f=locate_(d.id);version_(f,d.revision);if(!['draft','approved','planned'].includes(f.post.status))throw Error('Published or uncertain records cannot be deleted.');f.sheet.deleteRow(f.row);audit_('delete',d.id);return {deleted:true};});
 case 'manualPublish':return locked_(()=>{const f=locate_(d.id);version_(f,d.revision);if(!['approved','planned','publish_unknown','publishing'].includes(f.post.status))throw Error('Review and approve the post first.');validatePost_(f.post);if(!/^https:\/\/(www\.)?linkedin\.com\/(feed\/update\/|posts\/)/.test(d.url||''))throw Error('A LinkedIn post URL is required.');f.post.status='published';f.post.publishedUrl=d.url;const p=put_(f.post,f);audit_('manual_publish',d.id);return p;});
 case 'reconcile':return locked_(()=>{const f=locate_(d.id);version_(f,d.revision);if(!['publishing','publish_unknown'].includes(f.post.status))throw Error('No uncertain publication to reconcile.');if(Date.now()-Date.parse(f.post.updatedAt)<120000)throw Error('Wait two minutes after the attempt before reconciling.');validatePost_(f.post);f.post.status='approved';const saved=put_(f.post,f);audit_('confirmed_not_published',d.id);return saved;});
 case 'research':return research_();
 case 'oauthStart':return oauthStart_();
 case 'disconnect':return locked_(()=>{const p=props_();['LINKEDIN_ACCESS_TOKEN','LINKEDIN_EXPIRES_AT'].forEach(k=>p.deleteProperty(k));Object.keys(p.getProperties()).filter(k=>k.indexOf('OAUTH_STATE_')===0).forEach(k=>p.deleteProperty(k));audit_('linkedin_disconnect');return {disconnected:true};});
 case 'publish':return publish_(d);
 default:throw Error('Unknown action.');
}}
function doPost(e){let r={};let result;let origin='';try{if(!e||!e.parameter||!e.parameter.payload||e.parameter.payload.length>100000)throw Error('Invalid request.');r=JSON.parse(e.parameter.payload);origin=required_('PAGE_ORIGIN');authorized_(r);result={type:'black-star-response',id:r.id,ok:true,data:dispatch_(r)};}catch(err){result={type:'black-star-response',id:r.id,ok:false,error:String(err.message||'Request failed.').slice(0,700)};}
 // HtmlService runs the response inside Google's sandbox. top is the embedding Pages tab.
 const json=JSON.stringify(result).replace(/</g,'\\u003c').replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029');const target=JSON.stringify(origin).replace(/</g,'\\u003c');
 return HtmlService.createHtmlOutput('<!doctype html><meta charset="utf-8"><script>window.top.postMessage('+json+','+target+');</script>').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}
function oauthStart_(){if(required_('LINKEDIN_APPROVED')!=='true')throw Error('Set LINKEDIN_APPROVED only after LinkedIn grants the required product and scope.');const client=required_('LINKEDIN_CLIENT_ID'),redirect=required_('LINKEDIN_REDIRECT_URI');return locked_(()=>{const p=props_();Object.keys(p.getProperties()).filter(k=>k.indexOf('OAUTH_STATE_')===0).forEach(k=>{if(Number(p.getProperty(k))<Date.now())p.deleteProperty(k);});const state=Utilities.getUuid()+Utilities.getUuid();p.setProperty('OAUTH_STATE_'+digest_(state),String(Date.now()+10*60*1000));const q={response_type:'code',client_id:client,redirect_uri:redirect,state:state,scope:'w_organization_social'};return {url:'https://www.linkedin.com/oauth/v2/authorization?'+Object.keys(q).map(k=>encodeURIComponent(k)+'='+encodeURIComponent(q[k])).join('&')};});}
function doGet(e){try{const q=e&&e.parameter||{};if(!q.state)return HtmlService.createHtmlOutput('Black Star Studio backend. Return to your Studio tab to connect.');locked_(()=>{const p=props_(),key='OAUTH_STATE_'+digest_(q.state),expiry=Number(p.getProperty(key));p.deleteProperty(key);if(!expiry||expiry<Date.now())throw Error('Invalid or expired authorization state. Start again from Studio.');if(q.error||!q.code)throw Error('LinkedIn authorization was declined.');const response=UrlFetchApp.fetch('https://www.linkedin.com/oauth/v2/accessToken',{method:'post',payload:{grant_type:'authorization_code',code:q.code,client_id:required_('LINKEDIN_CLIENT_ID'),client_secret:required_('LINKEDIN_CLIENT_SECRET'),redirect_uri:required_('LINKEDIN_REDIRECT_URI')},muteHttpExceptions:true});if(response.getResponseCode()!==200)throw Error('LinkedIn token exchange failed. Check the application configuration.');const token=JSON.parse(response.getContentText());if(!token.access_token||!Number(token.expires_in))throw Error('LinkedIn returned an invalid token.');if(token.scope&&String(token.scope).split(/[ ,]+/).indexOf('w_organization_social')<0)throw Error('Required Page publishing permission was not granted.');p.setProperty('LINKEDIN_ACCESS_TOKEN',token.access_token);p.setProperty('LINKEDIN_EXPIRES_AT',String(Date.now()+Number(token.expires_in)*1000));audit_('linkedin_connected');});return HtmlService.createHtmlOutput('LinkedIn authorization saved securely. Close this tab, return to Black Star Studio and check the connection.');}catch(err){return HtmlService.createHtmlOutput('Authorization was not completed. Return to Studio and start again. Check approval, redirect URI and Page permissions.');}}
function publish_(d){return locked_(()=>{if(!ready_())throw Error('LinkedIn is not ready. Use manual publishing or reconnect.');const f=locate_(d.id);version_(f,d.revision);if(!['approved','planned'].includes(f.post.status))throw Error('Only approved posts can be published. An uncertain attempt must be reconciled in LinkedIn.');validatePost_(f.post);const p=f.post;p.status='publishing';put_(p,f);audit_('publish_started',p.id);
 try{const response=UrlFetchApp.fetch('https://api.linkedin.com/rest/posts',{method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+required_('LINKEDIN_ACCESS_TOKEN'),'Linkedin-Version':required_('LINKEDIN_VERSION'),'X-Restli-Protocol-Version':'2.0.0'},payload:JSON.stringify({author:'urn:li:organization:'+required_('LINKEDIN_ORGANIZATION_ID'),commentary:p.body,visibility:'PUBLIC',distribution:{feedDistribution:'MAIN_FEED',targetEntities:[],thirdPartyDistributionChannels:[]},lifecycleState:'PUBLISHED',isReshareDisabledByAuthor:false}),muteHttpExceptions:true});
 const status=response.getResponseCode();if(status!==201){p.status=status>=500?'publish_unknown':'approved';put_(p,{sheet:f.sheet,row:f.row,post:p});audit_('publish_http_'+status,p.id);throw Error('LinkedIn returned HTTP '+status+'. Reconnect to reload. '+(status>=500?'Check the Page before attempting anything else.':'Check product approval, Page role, API version and token.'));}
 const headers=response.getAllHeaders(),key=Object.keys(headers).find(k=>k.toLowerCase()==='x-restli-id'),urn=key?String(headers[key]):'';p.status='published';p.publishedUrl=urn?'https://www.linkedin.com/feed/update/'+encodeURIComponent(urn)+'/':'';const saved=put_(p,{sheet:f.sheet,row:f.row,post:p});audit_('api_publish',p.id);return saved;
 }catch(err){if(p.status==='publishing'){p.status='publish_unknown';put_(p,{sheet:f.sheet,row:f.row,post:p});audit_('publish_uncertain',p.id);throw Error('Publication outcome is uncertain. Reconnect, inspect the LinkedIn Page, and record its post URL if it published. Never blindly retry.');}throw err;}
 });}
function research_(){const cache=CacheService.getScriptCache(),cached=cache.get('fmcsa-research');if(cached)return JSON.parse(cached);const url='https://www.federalregister.gov/api/v1/documents.json?conditions%5Bagencies%5D%5B%5D=federal-motor-carrier-safety-administration&order=newest&per_page=12';const res=UrlFetchApp.fetch(url,{muteHttpExceptions:true});if(res.getResponseCode()!==200)throw Error('Federal Register is unavailable. Use the source links and try later.');const data=JSON.parse(res.getContentText());const articles=(data.results||[]).map(a=>({id:String(a.document_number),title:String(a.title),url:String(a.html_url),date:String(a.publication_date),type:String(a.type)}));cache.put('fmcsa-research',JSON.stringify(articles),3600);return articles;}
